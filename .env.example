# Copy this file to .env and fill in your values
# Never commit your real .env file

# Which provider to use by default: openai | gemini
AI_PROVIDER=openai

# Model name (provider-specific)
# OpenAI examples: gpt-4o-mini, gpt-4o, gpt-4-turbo
# Gemini examples: gemini-1.5-flash, gemini-1.5-pro
AI_MODEL=gpt-4o-mini

# --- OpenAI ---
OPENAI_API_KEY=

# --- Gemini ---
GEMINI_API_KEY=

# Optional: request timeout in ms
AI_TIMEOUT_MS=60000

# Optional: max file size (bytes) the tool will read/send to the API
AI_MAX_FILE_BYTES=200000
